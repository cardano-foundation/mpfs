# Use the official Node.js image as the base image
FROM node:24.22.0-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f

ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/cardano-foundation/mpfs" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"

# Set the working directory inside the container
RUN apk add --no-cache tree jq curl
# Copy package.json and package-lock.json to the working directory
COPY package*.json ./

# Install dependencies with an explicit npm 10 release;
# npm 11, bundled with node 24, rejects package-lock.json as out of sync
RUN npm install --global npm@10.9.9 && npm ci
# COPY node_modules/@meshsdk ./node_modules/@meshsdk

# Copy the rest of the application code to the working directory
COPY src .

# Expose the port the app runs on
EXPOSE 3000

# Start the application
ENTRYPOINT ["npx", "tsx", "service/signingless/main.ts"]
